# Frontend - environment variables
# Copy this to .env.local in this same folder (Next.js convention - NOT .env).

# The frontend only ever talks to the API Gateway - never directly to any
# individual backend service. Must start with NEXT_PUBLIC_ to be readable
# in browser code (Next.js only exposes env vars with this prefix to the
# client bundle - this is intentional and a Next.js requirement, not a
# choice we made).
NEXT_PUBLIC_API_URL=http://localhost:4000
