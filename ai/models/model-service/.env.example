# Model Service - environment variables
# Copy this to .env in this same folder and adjust if needed.

PORT=4004

# ─── Primary Provider: Z.ai (Zhipu AI) ──────────────────────────────
# GLM-4.7-Flash is FREE for all registered accounts (200K context).
# Get a free key at https://z.ai/manage-apikey/apikey-list
ZAI_API_KEY=paste_your_zai_api_key_here
ZAI_MODEL=glm-4.7-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ─── Alternative Providers (uncomment & configure as needed) ─────────
# CEREBRAS_API_KEY=paste_your_cerebras_api_key_here
# ANTHROPIC_API_KEY=paste_your_anthropic_api_key_here
# GEMINI_API_KEY=paste_your_gemini_api_key_here

# ─── Shared Secret ──────────────────────────────────────────────────
# MUST match JWT_SECRET in every other service's .env exactly - this
# service verifies the same tokens with the same secret.
JWT_SECRET=change_this_to_a_long_random_string_before_production
