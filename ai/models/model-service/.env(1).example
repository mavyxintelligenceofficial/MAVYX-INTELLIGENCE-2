# Model Service - environment variables
# Copy this to .env in this same folder and adjust if needed.

PORT=4004

# Chosen provider for now: Google Gemini (genuinely free tier, no credit
# card required). Get a free key at https://aistudio.google.com/apikey
# Switching to a paid provider (Anthropic, OpenAI) later only means
# writing one new provider class - see providers/anthropic_provider.py
# for the disabled reference implementation.
GEMINI_API_KEY=paste_your_gemini_api_key_here

# MUST match JWT_SECRET in every other service's .env exactly - this
# service verifies the same tokens with the same secret.
JWT_SECRET=change_this_to_a_long_random_string_before_production
