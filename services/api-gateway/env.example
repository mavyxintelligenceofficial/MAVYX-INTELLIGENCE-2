# API Gateway - environment variables
# Copy this to .env in this same folder and adjust if needed.

PORT=4000
DATABASE_URL=postgresql://mavyx:mavyx_dev_password@localhost:5432/mavyx_intelligence

# Where the Authentication Service is running - the gateway forwards
# /auth/* requests here instead of implementing auth itself.
AUTH_SERVICE_URL=http://localhost:4001

# Where the User Service is running - the gateway forwards /profile/*
# requests here (including the client's Authorization header).
USER_SERVICE_URL=http://localhost:4002

# Where the Market Service is running - the gateway forwards /market/*
# requests here (including the client's Authorization header).
MARKET_SERVICE_URL=http://localhost:4003

# Where the AI Service (model-service) is running - the gateway forwards
# /ai/* requests here for AI analysis and generation.
AI_SERVICE_URL=http://localhost:4004

# The frontend's origin, for CORS - browsers block cross-origin requests
# by default, so this must match wherever apps/web is actually running.
FRONTEND_URL=http://localhost:3000

# MUST match JWT_SECRET in authentication-service/.env, user-service/.env,
# AND market-service/.env exactly - every service verifies the same
# tokens with the same secret.
JWT_SECRET=change_this_to_a_long_random_string_before_production
