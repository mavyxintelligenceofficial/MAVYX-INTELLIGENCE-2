# Market Service - environment variables
# Copy this to .env in this same folder and adjust if needed.

PORT=4003

# Chosen provider for Phase 3: Twelve Data (https://twelvedata.com/).
# Sign up for a free API key at https://twelvedata.com/pricing and paste it below.
MARKET_DATA_PROVIDER=twelvedata
MARKET_DATA_API_KEY=paste_your_twelve_data_api_key_here

# Shared Redis instance (already running via the root docker-compose.yml) -
# used to cache quotes briefly so we don't burn through the free tier's
# rate limit every time a user's dashboard refreshes.
REDIS_URL=redis://localhost:6379

# MUST match JWT_SECRET in authentication-service/.env, user-service/.env,
# AND api-gateway/.env exactly - every service verifies the same tokens
# with the same secret.
JWT_SECRET=change_this_to_a_long_random_string_before_production
