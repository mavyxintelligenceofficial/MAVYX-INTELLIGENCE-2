# Mavyx Intelligence — Environment Configuration
# Per Volume V Chapter 7 §7.12: Configuration Management
#
# Copy this file to .env and fill in your values.
# NEVER commit .env files to git (already in .gitignore).

# ─── Database ──────────────────────────────────────────────────────
POSTGRES_USER=mavyx
POSTGRES_PASSWORD=mavyx_dev_password
POSTGRES_DB=mavyx_intelligence
DATABASE_URL=postgresql://mavyx:mavyx_dev_password@localhost:5432/mavyx_intelligence

# ─── Security ──────────────────────────────────────────────────────
# MUST be the same across ALL services
JWT_SECRET=change_this_to_a_long_random_string_before_production

# ─── Market Data ───────────────────────────────────────────────────
TWELVE_DATA_API_KEY=your_twelve_data_api_key_here

# ─── AI Provider (Z.ai) ───────────────────────────────────────────
ZAI_API_KEY=your_zai_api_key_here
ZAI_MODEL=glm-4.5-flash
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# ─── Frontend ──────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000

# ─── Service URLs (for Docker networking) ─────────────────────────
AUTH_SERVICE_URL=http://localhost:4001
USER_SERVICE_URL=http://localhost:4002
MARKET_SERVICE_URL=http://localhost:4003
AI_SERVICE_URL=http://localhost:4004
